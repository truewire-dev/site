# Cloudflare Workers static-asset headers (developers.cloudflare.com/workers/static-assets/headers/).
# Copied into .svelte-kit/cloudflare by adapter-cloudflare at build time. Every page is
# prerendered, so these apply to the whole site. The Content-Security-Policy is not here:
# SvelteKit emits it as a hashed <meta> tag per page (see svelte.config.js), since the
# hydration script it inlines needs a hash only the build knows.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# Without an explicit charset, some HTTP clients (Python's `requests`, notably) default
# unlabeled text/* responses to ISO-8859-1 and garble every non-ASCII character.
/docs/*.md
  Content-Type: text/markdown; charset=utf-8

/*.md
  Content-Type: text/markdown; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

# Cloudflare combines matching header values; detach the global CORP restriction
# instead of appending cross-origin to same-origin. Editors may fetch these schemas.
/schemas/*
  ! Cross-Origin-Resource-Policy
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *
