{
  "name": "truewire-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "render-docs": "node scripts/render-docs.mjs",
    "predev": "npm run render-docs",
    "prebuild": "npm run render-docs",
    "predeploy": "npm run render-docs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "vite build && wrangler deploy --env=\"\"",
    "deploy:dev": "yarn run build && wrangler d1 migrations apply LEADS --env dev --remote && wrangler deploy --env dev",
    "leads": "node scripts/leads.mjs",
    "test": "node --experimental-strip-types --test tests/inquiries.test.mjs",
    "test:browser": "playwright test",
    "db:local": "wrangler d1 migrations apply LEADS --env dev --local"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.2.0",
    "marked": "^17.0.1",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.3",
    "shiki": "^3.21.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.4",
    "wrangler": "^4.90.0"
  }
}
