{
  "name": "truewire-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "sync-schemas": "node scripts/sync-schemas.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:schemas-built": "node --test scripts/tests/schemas-built.mjs",
    "render-docs": "node scripts/render-docs.mjs",
    "predev": "npm run render-docs",
    "prebuild": "npm run render-docs",
    "predeploy": "npm run render-docs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "yarn run test && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "vite build && wrangler deploy --env=\"\""
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.2.0",
    "marked": "^17.0.1",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.3",
    "shiki": "^3.21.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.4",
    "wrangler": "^4.90.0"
  },
  "resolutions": {
    "sharp": "^0.35.4"
  }
}
