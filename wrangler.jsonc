{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "truewire-site",
  "compatibility_date": "2026-05-11",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "routes": [
    {
      "pattern": "truewire.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  },
  "env": {
    "dev": {
      "name": "truewire-site-dev",
      "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare"
      },
      "routes": [
        {
          "pattern": "dev.truewire.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
